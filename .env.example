# Toggle Sepurux tracing from runner.py
SEPURUX_ENABLE_TRACING=true

# Sepurux API connection
SEPURUX_API_BASE_URL=http://localhost:8000
SEPURUX_API_KEY=replace_with_real_key
SEPURUX_PROJECT_ID=replace_with_local_project_id

# Optional trace metadata
# Leave blank unless this campaign exists in your Sepurux project.
SEPURUX_CAMPAIGN=
SEPURUX_MUTATION_PACK=
# NOTE: Mutation pack requires SEPURUX_CAMPAIGN to be set.
SEPURUX_TASK_NAME=crashlab_tool_agent_demo.run_agent
